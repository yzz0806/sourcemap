# sourcemap keys. Copy to .env and fill in. .env is git-ignored; never commit it.
# Only the CLI reads this file; each adapter's child process gets only the keys it needs (ADR 0008).

# Open DART (Korean filings) — free: https://opendart.fss.or.kr  — stage 2
OPENDART_API_KEY=

# Telem (web search for discovery, the provider benchmark and the change monitor) — stage 3
TELEM_API_KEY=

# Tavily — not used by the code; search goes through Telem (ADR 0010). Kept here for reference.
TAVILY_API_KEY=

# OpenRouter (judge model) — stage 4
OPENROUTER_API_KEY=

# Apify (LinkedIn lookups) — stage 4
APIFY_TOKEN=

# Optional: an email for the OpenAlex polite pool (a generic team address is fine)
OPENALEX_EMAIL=

# SEC EDGAR contact for the User-Agent header: "Name email"
SEC_USER_AGENT=
